APP_PORT=8083

DB_HOST=host.docker.internal
DB_PORT=3308
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SUBSCRIPTION_DELIVERY_ORDER=msa4-team1.subscription.delivery-orders.v1
KAFKA_TOPIC_AUTH_USER=msa4-team1.auth.user-events.v1
DELIVERY_AUTH_CONSUMER_GROUP=delivery-service-auth-group
DELIVERY_ORDER_CONSUMER_GROUP=delivery-service-order-group
KAFKA_RETRY_INTERVAL_MS=1000
KAFKA_MAX_RETRIES=3

KAFKA_TOPIC_DELIVERY_EVENT=msa4-team1.delivery.delivery-events.v1
KAFKA_TOPIC_DELIVERY_REFUND_EVENT=msa4-team1.delivery.refund-events.v1
KAFKA_TOPIC_OPERATION_NOTIFICATION=msa4-team1.delivery.operation-notification-requests.v1

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=msa4-team1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_IMAGE_PATH=delivery/completion-photos
DELIVERY_PHOTO_MAX_FILE_SIZE=10MB
DELIVERY_PHOTO_MAX_REQUEST_SIZE=11MB
DELIVERY_PHOTO_PRESIGNED_GET_EXPIRATION=10m
DELIVERY_PHOTO_MAX_FILE_SIZE_BYTES=10485760

PERSONAL_DATA_ENCRYPTION_KEY=
DELIVERY_INTERNAL_API_KEY=

# 격리된 배포 검증 중에만 true로 설정하세요. 기사 확인의 배송일·시간 제한만 우회합니다.
DELIVERY_VERIFICATION_BYPASS_ACKNOWLEDGEMENT_WINDOW=false
# 자동 배정 대상일입니다. 운영 기본값 1은 내일이고, 오늘 대상 검증은 0으로 설정하세요.
DELIVERY_VERIFICATION_AUTO_ASSIGNMENT_TARGET_DATE_OFFSET_DAYS=1
# 확인 알림 대상일입니다. 운영·당일 검증 기본값은 0입니다.
DELIVERY_VERIFICATION_RIDER_ACK_TARGET_DATE_OFFSET_DAYS=0

# 기본값은 운영 스케줄입니다. 배포 검증 중 필요한 작업 하나만 1분 cron으로 바꾸세요.
DELIVERY_AUTO_ASSIGNMENT_INTERVAL_CRON=0 10,20,30,40,50 16 * * *
DELIVERY_AUTO_ASSIGNMENT_FINAL_CRON=0 0 17 * * *
DELIVERY_ACK_LUNCH_OPEN_CRON=0 0 7 * * *
DELIVERY_ACK_LUNCH_FIRST_REMINDER_CRON=0 0 8 * * *
DELIVERY_ACK_LUNCH_FINAL_REMINDER_CRON=0 30 8 * * *
DELIVERY_ACK_DINNER_OPEN_CRON=0 0 13 * * *
DELIVERY_ACK_DINNER_FIRST_REMINDER_CRON=0 0 14 * * *
DELIVERY_ACK_DINNER_FINAL_REMINDER_CRON=0 30 14 * * *
